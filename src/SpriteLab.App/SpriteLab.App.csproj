<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/SpriteLab.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/SpriteLab.png" />
    <EmbeddedResource Include="Localization/en.json" LogicalName="SpriteLab.Localization.en.json" />
    <ProjectReference Include="../SpriteLab.Core/SpriteLab.Core.csproj" />
    <ProjectReference Include="../SpriteLab.Infrastructure/SpriteLab.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Updates/PublicKey.pem')">
    <EmbeddedResource Include="Updates/PublicKey.pem" LogicalName="SpriteLab.UpdatePublicKey.pem" />
  </ItemGroup>
</Project>
