<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SpriteLab.App.Views"
        x:Class="SpriteLab.App.Views.MainWindow"
        Title="SpriteLab" Icon="avares://SpriteLab.App/Assets/SpriteLab.png" Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#171B22">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0" Background="#242A34">
      <MenuItem Header="_Archivo">
        <MenuItem x:Name="ImportMenu" Header="Importar PNG..." Click="OnImport" />
        <MenuItem x:Name="OpenProjectMenu" Header="Abrir proyecto..." HotKey="Ctrl+O" Click="OnOpenProject" />
        <MenuItem x:Name="SaveProjectMenu" Header="Guardar proyecto..." HotKey="Ctrl+S" Click="OnSaveProject" />
        <Separator />
        <MenuItem Header="Salir" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edición">
        <MenuItem Header="Deshacer" IsEnabled="False" />
        <MenuItem Header="Rehacer" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Ver">
        <MenuItem x:Name="GridMenu" Header="Mostrar/ocultar cuadrícula" IsEnabled="False" Click="OnToggleGrid" />
        <MenuItem Header="Anclaje" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Animación">
        <MenuItem Header="Crear clip de la fila..." Click="OnCreateClip" />
        <MenuItem x:Name="PlayMenu" Header="Reproducir" IsEnabled="False" Click="OnPlay" />
      </MenuItem>
      <MenuItem Header="_Herramientas">
        <MenuItem Header="Validar" IsEnabled="False" />
        <MenuItem Header="Sprite Pipeline" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="Ay_uda">
        <MenuItem Header="Acerca de SpriteLab" Click="OnAbout" />
      </MenuItem>
    </Menu>
    <Border Grid.Row="1" Background="#202630" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="SPRITELAB" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="Espacio de trabajo" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="ProjectText" Text="Proyecto sin guardar" Classes="muted" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="230,5,*,5,260" RowDefinitions="*,5,180,5,100">
      <Border Grid.Column="0" Grid.RowSpan="5" Background="#202630" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="EXPLORADOR" Classes="panelHeading" Margin="0,0,0,12" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
            <Button x:Name="ImportButton" Content="Importar PNG..." Click="OnImport" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="ResourceText" Text="Todavía no hay recursos." Classes="muted" />
            <ListBox x:Name="ResourceList" MaxHeight="220" SelectionChanged="OnResourceSelected" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="RenameResourceButton" Content="Renombrar" Click="OnRenameResource" IsEnabled="False" />
              <Button x:Name="RemoveResourceButton" Content="Quitar" Click="OnRemoveResource" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="CLIPS" Classes="panelHeading" />
            <ListBox x:Name="ClipList" MaxHeight="180" SelectionChanged="OnClipSelected" />
            <Button Content="Crear clip de la fila..." Click="OnCreateClip" />
            <Button Content="Quitar clip" Click="OnRemoveClip" />
            <TextBlock Text="DIRECCIONES" Classes="panelHeading" />
            <ComboBox x:Name="TrackList" HorizontalAlignment="Stretch" SelectionChanged="OnTrackSelected" />
            <Button Content="Asignar fila a dirección..." Click="OnAssignTrack" />
            <Button Content="Quitar dirección" Click="OnRemoveTrack" />
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Grid.RowSpan="5" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border Grid.Column="2" Grid.Row="0" Background="#11151C" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="VISOR" Classes="panelHeading" />
            <TextBlock Grid.Column="1" x:Name="ViewerInfo" Text="Sin imagen" Classes="muted" />
          </Grid>
          <StackPanel x:Name="EmptyViewer" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
            <Border Width="68" Height="68" BorderBrush="#526173" BorderThickness="1" CornerRadius="6">
              <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                <Border Background="#303946" />
                <Border Grid.Column="1" Background="#222A35" />
                <Border Grid.Row="1" Background="#222A35" />
                <Border Grid.Row="1" Grid.Column="1" Background="#303946" />
              </Grid>
            </Border>
            <TextBlock Text="No hay ningún sprite seleccionado" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Importa un PNG para visualizar la hoja de sprites." Classes="muted" TextAlignment="Center" />
          </StackPanel>
          <Grid x:Name="ImageViewer" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
              <Button Content="−" Click="OnZoomOut" />
              <TextBlock x:Name="ZoomText" Text="100 %" VerticalAlignment="Center" />
              <Button Content="+" Click="OnZoomIn" />
              <Button Content="1:1" Click="OnZoomReset" />
              <Button Content="Ajustar (entero)" Click="OnFit" />
              <Button Content="Cuadrícula" Click="OnToggleGrid" />
            </StackPanel>
            <ScrollViewer x:Name="SheetScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <views:SheetPreview x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Grid.RowSpan="5" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border Grid.Column="4" Grid.RowSpan="5" Background="#202630" Padding="12">
        <StackPanel Spacing="12">
          <TextBlock Text="PROPIEDADES" Classes="panelHeading" />
          <TextBlock Text="Imagen" FontWeight="SemiBold" />
          <TextBlock x:Name="ResolutionText" Text="Resolución: —" Classes="muted" />
          <TextBlock Text="Tamaño de celda (px)" Classes="muted" />
          <Grid ColumnDefinitions="*,*">
            <TextBox x:Name="CellWidth" Watermark="Ancho" Text="48" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" x:Name="CellHeight" Watermark="Alto" Text="48" Margin="4,0,0,0" />
          </Grid>
          <Button x:Name="ApplyGridButton" Content="Aplicar cuadrícula" Click="OnApplyGrid" IsEnabled="False" HorizontalAlignment="Stretch" />
          <TextBlock x:Name="GridInfo" Text="Sin cuadrícula" Classes="muted" />
          <Separator />
          <TextBlock Text="Fotograma" FontWeight="SemiBold" />
          <views:FramePreview x:Name="FramePreview" Width="112" Height="112" HorizontalAlignment="Center" />
          <TextBlock x:Name="FrameInfo" Text="Sin selección" Classes="muted" />
          <TextBlock x:Name="RectInfo" Text="Rectángulo: —" Classes="muted" />
          <TextBlock x:Name="DurationInfo" Text="Duración: —" Classes="muted" />
          <TextBlock x:Name="AnchorInfo" Text="Anclaje: —" Classes="muted" />
          <TextBlock Text="Desplazamiento: —" Classes="muted" />
        </StackPanel>
      </Border>
      <GridSplitter Grid.Column="2" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border Grid.Column="2" Grid.Row="2" Background="#202630" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Text="LÍNEA DE TIEMPO" Classes="panelHeading" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,8">
            <Button x:Name="PreviousButton" Content="Anterior" IsEnabled="False" Click="OnPrevious" />
            <Button x:Name="PlayButton" Content="Reproducir" IsEnabled="False" Click="OnPlay" />
            <Button x:Name="StopButton" Content="Parar" IsEnabled="False" Click="OnStop" />
            <Button x:Name="NextButton" Content="Siguiente" IsEnabled="False" Click="OnNext" />
            <CheckBox x:Name="LoopCheck" Content="Bucle" IsEnabled="False" IsChecked="True" />
          </StackPanel>
          <Border Grid.Row="2" Background="#171B22" Padding="10" CornerRadius="4">
            <Grid RowDefinitions="Auto,*">
              <TextBlock x:Name="TimelineInfo" Text="Sin fotogramas" Classes="muted" />
              <views:CellStrip x:Name="CellStrip" Grid.Row="1" MinHeight="54" />
            </Grid>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="2" Grid.Row="3" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border Grid.Column="2" Grid.Row="4" Background="#202630" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="DIAGNÓSTICOS" Classes="panelHeading" />
          <TextBlock Text="Validación no ejecutada." Classes="muted" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#242A34" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Text="Listo · Sin proyecto" Classes="muted" />
        <TextBlock Grid.Column="1" x:Name="VersionText" Classes="muted" />
      </Grid>
    </Border>
  </Grid>
</Window>
