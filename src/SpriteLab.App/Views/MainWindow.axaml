<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SpriteLab.App.Views"
        x:Class="SpriteLab.App.Views.MainWindow"
        Title="SpriteLab" Icon="avares://SpriteLab.App/Assets/SpriteLab.png" Width="1280" Height="800"
        MinWidth="1040" MinHeight="760"
        SystemDecorations="BorderOnly" Background="#171B22">
  <Window.Styles>
    <Style Selector="Button.captionButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.captionButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#394352" />
    </Style>
    <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B36" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" Background="#242A34" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Height="36">
      <Border Background="Transparent" Padding="10,0" PointerPressed="OnCaptionPressed">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://SpriteLab.App/Assets/SpriteLab.png" Width="20" Height="20" />
          <TextBlock Text="SpriteLab" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center">
      <MenuItem Header="_Archivo">
        <MenuItem x:Name="ImportMenu" Header="Importar PNG..." Click="OnImport" />
        <MenuItem x:Name="OpenProjectMenu" Header="Abrir proyecto..." HotKey="Ctrl+O" Click="OnOpenProject" />
        <MenuItem x:Name="SaveProjectMenu" Header="Guardar proyecto..." HotKey="Ctrl+S" Click="OnSaveProject" />
        <MenuItem x:Name="SaveAsMenu" Header="Guardar como..." HotKey="Ctrl+Shift+S" Click="OnSaveAs" />
        <MenuItem x:Name="RenameProjectMenu" Header="Renombrar proyecto..." Click="OnRenameProject" />
        <Separator />
        <MenuItem x:Name="ExportSpritesMenu" Header="Exportar sprites y animaciones…" Click="OnExportSprites" IsEnabled="False" />
        <Separator />
        <MenuItem Header="Salir" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edición">
        <MenuItem x:Name="UndoMenu" Header="Deshacer" HotKey="Ctrl+Z" Click="OnUndo" IsEnabled="False" />
        <MenuItem x:Name="RedoMenu" Header="Rehacer" HotKey="Ctrl+Y" Click="OnRedo" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Ver">
        <MenuItem x:Name="GridMenu" Header="Mostrar/ocultar cuadrícula" IsEnabled="False" Click="OnToggleGrid" />
        <MenuItem Header="Anclaje" IsEnabled="False" />
        <MenuItem Header="Restablecer distribución" Click="OnResetLayout" />
      </MenuItem>
      <MenuItem Header="_Animación">
        <MenuItem Header="Crear clip de la fila..." Click="OnCreateClip" />
        <MenuItem x:Name="PlayMenu" Header="Reproducir (Espacio)" IsEnabled="False" Click="OnPlay" />
      </MenuItem>
      <MenuItem Header="_Herramientas">
        <MenuItem x:Name="ValidateMenu" Header="Validar hoja" IsEnabled="False" Click="OnValidate" />
        <MenuItem x:Name="ProcessingMenu" Header="Procesamiento de imágenes…" Click="OnProcessImages" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="Ay_uda">
        <MenuItem Header="Acerca de SpriteLab" Click="OnAbout" />
      </MenuItem>
      </Menu>
      <Border Grid.Column="2" Background="Transparent" PointerPressed="OnCaptionPressed" />
      <Button Grid.Column="3" x:Name="CaptionMinimize" Click="OnCaptionMinimize" Classes="captionButton" Content="−" />
      <Button Grid.Column="4" x:Name="CaptionMaximize" Click="OnCaptionMaximize" Classes="captionButton" Content="□" />
      <Button Grid.Column="5" x:Name="CaptionClose" Click="OnCaptionClose" Classes="captionButton captionClose" Content="×" />
    </Grid>
    <Border Grid.Row="1" Background="#202630" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="SPRITELAB" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="Espacio de trabajo" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock x:Name="ProjectText" MaxWidth="320" TextTrimming="CharacterEllipsis" Text="Proyecto sin guardar" HorizontalAlignment="Right" Classes="muted" />
          <TextBlock x:Name="SaveIndicator" Text="Sin guardar" FontSize="11" HorizontalAlignment="Right" Classes="muted" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="2" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="210" MaxWidth="350" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="400" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="300" MinWidth="250" MaxWidth="450" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="5" />
        <RowDefinition Height="320" MinHeight="220" MaxHeight="440" />
        <RowDefinition Height="5" />
        <RowDefinition Height="210" MinHeight="120" MaxHeight="360" />
      </Grid.RowDefinitions>
      <Border ClipToBounds="True" Grid.Column="0" Grid.RowSpan="5" Background="#202630" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="RECURSOS Y CLIPS" Classes="panelHeading" Margin="0,0,0,12" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
            <Button x:Name="ImportButton" Content="Importar PNG..." Click="OnImport" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="ResourceText" Text="Todavía no hay recursos." Classes="muted" />
            <ListBox x:Name="ResourceList" MaxHeight="220" SelectionChanged="OnResourceSelected" />
            <WrapPanel Orientation="Horizontal">
              <Button x:Name="RenameResourceButton" Margin="0,0,6,4" Content="Renombrar" Click="OnRenameResource" IsEnabled="False" />
              <Button x:Name="RemoveResourceButton" Content="Quitar" Click="OnRemoveResource" IsEnabled="False" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock Text="ANIMACIONES" Classes="panelHeading" />
            <ListBox x:Name="ClipList" MaxHeight="180" SelectionChanged="OnClipSelected" />
            <Button x:Name="CreateClipButton" Content="Crear clip de la fila..." Click="OnCreateClip" />
            <Button x:Name="RemoveClipButton" Content="Quitar clip" Click="OnRemoveClip" />
            <Button x:Name="DeselectClipButton" Content="Deseleccionar clip" Click="OnDeselectClip" IsEnabled="False" />
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Grid.RowSpan="5" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border ClipToBounds="True" Grid.Column="2" Grid.Row="0" Background="#11151C" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="VISOR" Classes="panelHeading" />
            <TextBlock Grid.Column="1" x:Name="ViewerInfo" Text="Sin imagen" Classes="muted" />
          </Grid>
          <StackPanel x:Name="EmptyViewer" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
            <Border Width="68" Height="68" BorderBrush="#526173" BorderThickness="1" CornerRadius="6">
              <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                <Border Background="#303946" />
                <Border Grid.Column="1" Background="#222A35" />
                <Border Grid.Row="1" Background="#222A35" />
                <Border Grid.Row="1" Grid.Column="1" Background="#303946" />
              </Grid>
            </Border>
            <TextBlock Text="No hay ningún sprite seleccionado" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Importa un PNG para visualizar la hoja de sprites." Classes="muted" TextAlignment="Center" />
          </StackPanel>
          <Grid x:Name="ImageViewer" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
              <Button x:Name="ZoomOutButton" Content="−" Click="OnZoomOut" />
              <TextBlock x:Name="ZoomText" Text="100 %" VerticalAlignment="Center" />
              <Button x:Name="ZoomInButton" Content="+" Click="OnZoomIn" />
              <Button x:Name="ZoomResetButton" Content="1:1" Click="OnZoomReset" />
              <Button x:Name="FitButton" Content="Ajustar (entero)" Click="OnFit" />
              <Button x:Name="ToggleGridButton" Content="Cuadrícula" Click="OnToggleGrid" />
            </StackPanel>
            <ScrollViewer x:Name="SheetScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <views:SheetPreview x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Grid.RowSpan="5" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border ClipToBounds="True" Grid.Column="4" Grid.RowSpan="5" Background="#202630" Padding="12">
        <TabControl x:Name="InspectorTabs" SelectedIndex="0">
          <TabItem Header="Hoja"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10" Margin="0,8,0,0">
          <TextBlock Text="Imagen" FontWeight="SemiBold" />
          <TextBlock x:Name="ResolutionText" Text="Resolución: —" Classes="muted" />
          <TextBlock Text="Tamaño de celda (px)" Classes="muted" />
          <Grid ColumnDefinitions="*,*">
            <TextBox x:Name="CellWidth" Watermark="Ancho" Text="48" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" x:Name="CellHeight" Watermark="Alto" Text="48" Margin="4,0,0,0" />
          </Grid>
          <Button x:Name="SuggestGridButton" Content="Sugerir cuadrícula…" Click="OnSuggestGrid" IsEnabled="False" HorizontalAlignment="Stretch" />
          <Button x:Name="ApplyGridButton" Content="Aplicar cuadrícula" Click="OnApplyGrid" IsEnabled="False" HorizontalAlignment="Stretch" />
          <Button x:Name="RestoreGridButton" Content="Restablecer dimensiones" Click="OnRestoreGrid" IsEnabled="False" HorizontalAlignment="Stretch" />
          <TextBlock x:Name="GridInfo" Text="Sin cuadrícula" Classes="muted" />
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Vista"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10" Margin="0,8,0,0">
          <TextBlock Text="Fotograma" FontWeight="SemiBold" />
          <views:FramePreview x:Name="FramePreview" MaxWidth="200" Height="200" ClipToBounds="True" HorizontalAlignment="Stretch" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="FrameZoomOutButton" Content="−" Click="OnFrameZoomOut" />
            <TextBlock x:Name="FramePreviewZoom" VerticalAlignment="Center" Text="Ajustar" />
            <Button x:Name="FrameZoomInButton" Content="+" Click="OnFrameZoomIn" />
            <Button x:Name="FrameZoomResetButton" Content="Centrar" Click="OnFrameZoomReset" />
          </StackPanel>
          <TextBlock Text="Arrastra con el botón central para desplazar." Classes="muted" TextWrapping="Wrap" />
          <StackPanel x:Name="FrameEditPanel" Spacing="6" IsEnabled="False">
            <TextBlock Text="EDICIÓN NO DESTRUCTIVA" Classes="panelHeading" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="UndoButton" Content="Deshacer" Click="OnUndo" IsEnabled="False" />
              <Button x:Name="RedoButton" Content="Rehacer" Click="OnRedo" IsEnabled="False" />
            </StackPanel>
            <CheckBox x:Name="MoveSpriteCheck" Content="Mover sprite con botón izquierdo" IsCheckedChanged="OnMoveModeChanged" />
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
              <TextBlock Text="X" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="OffsetX" Text="0" />
              <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" x:Name="OffsetY" Text="0" />
            </Grid>
            <WrapPanel Orientation="Horizontal">
              <Button Content="Aplicar" Click="OnApplyOffset" Margin="0,0,6,0" />
              <Button Content="Restablecer" Click="OnResetOffset" />
            </WrapPanel>
            <CheckBox x:Name="SnapCheck" Content="Ajuste magnético (3 px)" IsCheckedChanged="OnSnapChanged" />
            <TextBlock Text="ANCLAJE / ORIGEN" Classes="panelHeading" />
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
              <TextBlock Text="X" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="AnchorX" Text="0" />
              <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" x:Name="AnchorY" Text="0" />
            </Grid>
            <ComboBox x:Name="AnchorPreset" SelectedIndex="-1" SelectionChanged="OnAnchorPreset">
              <ComboBoxItem Content="Centro inferior (pies)" />
              <ComboBoxItem Content="Centro de celda" />
            </ComboBox>
            <WrapPanel Orientation="Horizontal">
              <Button Content="Aplicar anclaje" Click="OnApplyAnchor" Margin="0,0,6,4" />
              <Button Content="Quitar" Click="OnClearAnchor" />
            </WrapPanel>
            <TextBlock Text="ALINEACIÓN AUTOMÁTICA" Classes="panelHeading" />
            <ComboBox x:Name="AlignMode" SelectedIndex="3">
              <ComboBoxItem Content="Centro horizontal visible" />
              <ComboBoxItem Content="Base visible" />
              <ComboBoxItem Content="Anclaje a centro inferior" />
              <ComboBoxItem Content="Centro y base visibles" />
            </ComboBox>
            <Button Content="Alinear selección" Click="OnAlignFrames" />
            <TextBlock Text="EDICIÓN MÚLTIPLE" Classes="panelHeading" />
            <CheckBox x:Name="BatchMode" Content="Editar varias celdas" />
            <TextBox x:Name="BatchCells" Watermark="Ej.: 1,3-5,8" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="Fila actual" Click="OnSelectRowCells" Margin="0,0,6,4" />
              <Button Content="Dirección actual" Click="OnSelectTrackCells" />
            </WrapPanel>
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
              <TextBlock Text="ΔX" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="DeltaX" Text="0" />
              <TextBlock Grid.Column="2" Text="ΔY" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" x:Name="DeltaY" Text="0" />
            </Grid>
            <Button Content="Mover selección (incremento)" Click="OnBatchDelta" />
            <TextBlock Text="Aplicar / Restablecer, anclajes y alinear actúan sobre la selección. Arrastrar mueve solo la celda visible." TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="GUÍAS VISUALES" Classes="panelHeading" />
            <CheckBox x:Name="CenterGuide" Content="Centro vertical" IsChecked="True" />
            <CheckBox x:Name="GroundGuide" Content="Línea de suelo" IsChecked="True" />
            <CheckBox x:Name="BoundsGuide" Content="Límite de celda" IsChecked="True" />
            <CheckBox x:Name="CustomGuide" Content="Guías personalizadas X / Y" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <TextBox x:Name="CustomGuideX" Text="0" />
              <TextBox Grid.Column="1" x:Name="CustomGuideY" Text="0" />
            </Grid>
            <Button Content="Actualizar guías" Click="OnApplyGuides" />
            <TextBlock Text="Guías relativas a la celda. No cambian el PNG." Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="Comparar poses (Onion skin)" Classes="panelHeading" />
          <WrapPanel Orientation="Horizontal">
            <CheckBox x:Name="OnionPrevious" Content="Anterior (rojo)" IsEnabled="False" Margin="0,0,8,0" />
            <CheckBox x:Name="OnionNext" Content="Siguiente (verde)" IsEnabled="False" />
          </WrapPanel>
          <CheckBox x:Name="OnionTint" Content="Tintes diferenciados" IsChecked="True" IsEnabled="False" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Opacidad" Classes="muted" />
            <TextBlock Grid.Column="1" x:Name="OnionOpacityText" Text="35%" Classes="muted" />
          </Grid>
          <Slider x:Name="OnionOpacity" Minimum="10" Maximum="80" Value="35" IsEnabled="False" />
          <TextBlock x:Name="OnionFeedback" TextWrapping="Wrap" Classes="muted" />
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Fotograma"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10" Margin="0,8,0,0">
          <TextBlock x:Name="FrameInfo" Text="Sin selección" Classes="muted" />
          <TextBlock x:Name="RectInfo" Text="Rectángulo: —" Classes="muted" />
          <TextBlock x:Name="VisibleBoundsInfo" Text="Área visible: valida la hoja" Classes="muted" TextWrapping="Wrap" />
          <TextBlock x:Name="DurationInfo" Text="Duración: —" Classes="muted" />
          <TextBlock x:Name="AnchorInfo" Text="Anclaje: —" Classes="muted" />
          <TextBlock x:Name="OffsetInfo" Text="Desplazamiento: —" Classes="muted" />
          </StackPanel></ScrollViewer></TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="2" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border ClipToBounds="True" Grid.Column="2" Grid.Row="2" Background="#202630" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="5">
            <TextBlock x:Name="AnimationHeading" Text="ANIMACIÓN Y LÍNEA DE TIEMPO · Sin clip" Classes="panelHeading" TextTrimming="CharacterEllipsis" />
            <WrapPanel Orientation="Horizontal">
              <ComboBox x:Name="TrackList" Width="145" Margin="0,0,6,4" SelectionChanged="OnTrackSelected" />
              <Button x:Name="AssignTrackButton" Content="Asignar fila..." Click="OnAssignTrack" Margin="0,0,6,4" />
              <Button x:Name="RemoveTrackButton" Content="Quitar dirección" Click="OnRemoveTrack" Margin="0,0,6,4" />
              <Button x:Name="EditSequenceButton" Content="Editar secuencia..." Click="OnEditSequence" IsEnabled="False" Margin="0,0,6,4" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
              <Button x:Name="PreviousButton" Content="Anterior" IsEnabled="False" Click="OnPrevious" Margin="0,0,4,4" />
              <Button x:Name="PlayButton" Content="Reproducir" IsEnabled="False" Click="OnPlay" Margin="0,0,4,4" />
              <Button x:Name="StopButton" Content="Parar" IsEnabled="False" Click="OnStop" Margin="0,0,4,4" />
              <Button x:Name="NextButton" Content="Siguiente" IsEnabled="False" Click="OnNext" Margin="0,0,4,4" />
              <CheckBox x:Name="LoopCheck" Content="Bucle" IsEnabled="False" IsChecked="True" Margin="0,0,4,4" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Slider x:Name="TimeScrubber" Minimum="0" Maximum="1" Value="0" IsEnabled="False" ToolTip.Tip="Desplazarse por el tiempo de la animación" />
              <TextBlock Grid.Column="1" x:Name="ScrubberTime" Text="— / —" Classes="muted" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="FPS" VerticalAlignment="Center" Margin="0,0,4,4" />
              <TextBox x:Name="FpsInput" Width="55" Text="8" IsEnabled="False" Margin="0,0,8,4" />
              <TextBlock Text="Duración (ms)" VerticalAlignment="Center" Margin="0,0,4,4" />
              <TextBox x:Name="DurationInput" Width="74" Watermark="Auto" IsEnabled="False" Margin="0,0,8,4" />
              <Button x:Name="ApplyTimingButton" Content="Aplicar tiempo" Click="OnApplyTiming" IsEnabled="False" Margin="0,0,4,4" />
            </WrapPanel>
            <Border Background="#171B22" Padding="6" CornerRadius="4">
              <StackPanel Spacing="4">
                <TextBlock x:Name="TimelineInfo" Text="Sin fotogramas" Classes="muted" />
                <views:CellStrip x:Name="CellStrip" Height="76" />
                <TextBlock Text="Arrastra las miniaturas para reordenar las visibles." Classes="muted" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button x:Name="ReplaceFrameButton" Content="Reemplazar" Click="OnReplaceFrame" IsEnabled="False" Margin="0,0,4,4" />
                  <Button x:Name="AddFrameButton" Content="+ Añadir" Click="OnAddFrame" IsEnabled="False" Margin="0,0,4,4" />
                  <Button x:Name="DuplicateFrameButton" Content="Duplicar" Click="OnDuplicateFrame" IsEnabled="False" Margin="0,0,4,4" />
                  <Button x:Name="RemoveFrameButton" Content="Quitar" Click="OnRemoveFrame" IsEnabled="False" Margin="0,0,4,4" />
                  <Button x:Name="MoveFrameLeftButton" Content="←" Click="OnMoveFrameLeft" IsEnabled="False" ToolTip.Tip="Mover fotograma a la izquierda" Margin="0,0,4,4" />
                  <Button x:Name="MoveFrameRightButton" Content="→" Click="OnMoveFrameRight" IsEnabled="False" ToolTip.Tip="Mover fotograma a la derecha" Margin="0,0,4,4" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <GridSplitter Grid.Column="2" Grid.Row="3" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#353E4C" />
      <Border ClipToBounds="True" Grid.Column="2" Grid.Row="4" Background="#202630" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="VALIDACIÓN · DIAGNÓSTICOS" Classes="panelHeading" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="ValidateButton" Content="Validar hoja" Click="OnValidate" IsEnabled="False" />
          </Grid>
          <TextBlock Grid.Row="1" x:Name="DiagnosticText" Text="Validación no ejecutada." Classes="muted" TextWrapping="Wrap" />
          <StackPanel Grid.Row="2" Spacing="4" Margin="0,4">
            <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="DiagnosticFilterBox" SelectedIndex="0" MinWidth="155" Margin="0,0,8,4">
              <ComboBoxItem Content="Todos los avisos" />
              <ComboBoxItem Content="Celdas vacías" />
              <ComboBoxItem Content="Bordes" />
              <ComboBoxItem Content="Duplicados" />
              <ComboBoxItem Content="Tamaño y alineación" />
              <ComboBoxItem Content="Animaciones" />
            </ComboBox>
            <CheckBox x:Name="DiagnosticOverlay" Content="Marcas sobre la hoja" IsChecked="True" Margin="0,0,8,4" VerticalAlignment="Center" />
            <Button x:Name="ExportReportButton" Content="Exportar informe…" Click="OnExportReport" IsEnabled="False" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock Text="Vacío gris · Borde naranja · Duplicado violeta · Alineación azul · Animación rosa" FontSize="10" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
          <ListBox Grid.Row="3" x:Name="FindingList" SelectionChanged="OnFindingSelected" />
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#242A34" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" Text="Listo · Sin proyecto" Classes="muted" />
        <TextBlock Grid.Column="1" x:Name="VersionText" Classes="muted" />
      </Grid>
    </Border>
  </Grid>
</Window>
