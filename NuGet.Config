<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Farga" value="https://nuget.pkg.github.com/Farga-Studios/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="Farga"><package pattern="FargaStudios.Suite.*" /></packageSource>
  </packageSourceMapping>
</configuration>
